const __vite__css = "/* HotelDashboard.css - High-Fidelity Styling for YatraSetu Hotel Partner Portal */\r\n\r\n.hotel-portal-wrapper {\r\n  background-color: #0f172a;\r\n  color: #f8fafc;\r\n  min-height: 100%;\r\n  border-radius: 20px;\r\n  padding: 0 0 32px 0;\r\n  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);\r\n  border: 1px solid #1e293b;\r\n}\r\n\r\n/* Animations */\r\n@keyframes pulse-ring {\r\n  0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }\r\n  70% { box-shadow: 0 0 0 14px rgba(245, 158, 11, 0); }\r\n  100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }\r\n}\r\n\r\n.ring-attention {\r\n  animation: pulse-ring 1.8s infinite;\r\n}\r\n\r\n@keyframes ping-slow {\r\n  0% { transform: scale(1); opacity: 1; }\r\n  75%, 100% { transform: scale(2); opacity: 0; }\r\n}\r\n\r\n.animate-ping-slow {\r\n  animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;\r\n}\r\n\r\n/* 1. Header & Top Bar */\r\n.hotel-portal-header {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 30;\r\n  background: rgba(15, 23, 42, 0.95);\r\n  backdrop-filter: blur(12px);\r\n  border-bottom: 1px solid #1e293b;\r\n  border-top-left-radius: 20px;\r\n  border-top-right-radius: 20px;\r\n}\r\n\r\n.hotel-portal-header-inner {\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  padding: 16px 24px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n\r\n.hotel-brand-box {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.hotel-icon-badge {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 16px;\r\n  background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  box-shadow: 0 8px 16px rgba(245, 158, 11, 0.25);\r\n  font-size: 24px;\r\n}\r\n\r\n.hotel-brand-titles {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.hotel-brand-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.hotel-brand-name {\r\n  font-size: 20px;\r\n  font-weight: 900;\r\n  background: linear-gradient(to right, #fbbf24, #f59e0b, #fef08a);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  letter-spacing: -0.5px;\r\n}\r\n\r\n.hotel-partner-pill {\r\n  font-size: 10.5px;\r\n  background: rgba(245, 158, 11, 0.15);\r\n  color: #fde68a;\r\n  border: 1px solid rgba(245, 158, 11, 0.35);\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  font-weight: 700;\r\n}\r\n\r\n.hotel-property-sub {\r\n  font-size: 12px;\r\n  color: #94a3b8;\r\n  display: flex;\r\n  align-items: center;\r\n  margin-top: 2px;\r\n}\r\n\r\n.hotel-property-sub strong {\r\n  color: #e2e8f0;\r\n}\r\n\r\n.hotel-live-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  background: #34d399;\r\n  display: inline-block;\r\n  margin-right: 6px;\r\n}\r\n\r\n.hotel-header-controls {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.hotel-verified-badge {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  background: rgba(16, 185, 129, 0.1);\r\n  border: 1px solid rgba(16, 185, 129, 0.3);\r\n  color: #34d399;\r\n  padding: 6px 12px;\r\n  border-radius: 12px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n}\r\n\r\n.hotel-reset-btn {\r\n  padding: 8px 14px;\r\n  border-radius: 12px;\r\n  border: 1px solid #334155;\r\n  background: #1e293b;\r\n  color: #cbd5e1;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n.hotel-reset-btn:hover {\r\n  background: #334155;\r\n  color: #fbbf24;\r\n  border-color: rgba(245, 158, 11, 0.4);\r\n}\r\n\r\n/* 2. Toast Alert Banners */\r\n.hotel-toast-container {\r\n  max-width: 1280px;\r\n  margin: 16px auto 0;\r\n  padding: 0 24px;\r\n}\r\n\r\n.hotel-fraud-banner {\r\n  background: rgba(69, 10, 10, 0.95);\r\n  border: 1px solid #f43f5e;\r\n  border-radius: 16px;\r\n  padding: 14px 18px;\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 14px;\r\n  box-shadow: 0 8px 24px rgba(69, 10, 10, 0.6);\r\n  backdrop-filter: blur(8px);\r\n}\r\n\r\n.fraud-icon-box {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  background: rgba(136, 19, 55, 0.8);\r\n  border: 1px solid #be123c;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 20px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.fraud-text-box h4 {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  color: #fecdd3;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.fraud-cooldown-badge {\r\n  font-size: 10px;\r\n  background: #881337;\r\n  color: #fda4af;\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n  font-family: monospace;\r\n}\r\n\r\n.fraud-text-box p {\r\n  margin: 4px 0 0;\r\n  font-size: 12px;\r\n  color: #fda4af;\r\n}\r\n\r\n.toast-dismiss-btn {\r\n  background: transparent;\r\n  border: none;\r\n  color: #fda4af;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  padding: 4px 8px;\r\n  margin-left: auto;\r\n}\r\n\r\n.hotel-success-banner {\r\n  background: rgba(6, 78, 59, 0.9);\r\n  border: 1px solid #10b981;\r\n  border-radius: 16px;\r\n  padding: 14px 18px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n  box-shadow: 0 8px 24px rgba(6, 78, 59, 0.6);\r\n  backdrop-filter: blur(8px);\r\n}\r\n\r\n.success-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n\r\n.success-icon-box {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  background: rgba(16, 185, 129, 0.2);\r\n  border: 1px solid rgba(16, 185, 129, 0.4);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 20px;\r\n}\r\n\r\n.success-text-box h4 {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  color: #a7f3d0;\r\n}\r\n\r\n.success-text-box p {\r\n  margin: 2px 0 0;\r\n  font-size: 12px;\r\n  color: #6ee7b7;\r\n}\r\n\r\n/* 3. Main Dashboard Layout */\r\n.hotel-main-body {\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  padding: 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 24px;\r\n}\r\n\r\n/* HERO SECTION */\r\n.hotel-hero-card {\r\n  position: relative;\r\n  overflow: hidden;\r\n  border-radius: 24px;\r\n  background: linear-gradient(135deg, #451a03 0%, #0f172a 60%, #1e293b 100%);\r\n  border: 1px solid rgba(245, 158, 11, 0.4);\r\n  padding: 28px 32px;\r\n  box-shadow: 0 12px 32px rgba(69, 26, 3, 0.4);\r\n}\r\n\r\n.hotel-hero-glow {\r\n  position: absolute;\r\n  right: -60px;\r\n  bottom: -60px;\r\n  width: 260px;\r\n  height: 260px;\r\n  background: rgba(245, 158, 11, 0.12);\r\n  border-radius: 50%;\r\n  filter: blur(60px);\r\n  pointer-events: none;\r\n}\r\n\r\n.hotel-hero-content {\r\n  position: relative;\r\n  z-index: 10;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 24px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hero-left-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  max-width: 700px;\r\n}\r\n\r\n.hero-tags-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.demand-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 4px 12px;\r\n  border-radius: 999px;\r\n  font-size: 11.5px;\r\n  font-weight: 800;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.demand-badge.normal {\r\n  background: rgba(16, 185, 129, 0.2);\r\n  color: #6ee7b7;\r\n  border: 1px solid rgba(16, 185, 129, 0.4);\r\n}\r\n\r\n.demand-badge.surge {\r\n  background: rgba(225, 29, 72, 0.2);\r\n  color: #fda4af;\r\n  border: 1px solid rgba(225, 29, 72, 0.5);\r\n  box-shadow: 0 0 12px rgba(225, 29, 72, 0.4);\r\n}\r\n\r\n.hub-location-tag {\r\n  font-size: 11.5px;\r\n  color: #94a3b8;\r\n  background: rgba(30, 41, 59, 0.8);\r\n  padding: 4px 12px;\r\n  border-radius: 999px;\r\n  border: 1px solid #334155;\r\n}\r\n\r\n.hero-metrics-title {\r\n  margin: 0;\r\n  font-size: 26px;\r\n  font-weight: 800;\r\n  color: #ffffff;\r\n  letter-spacing: -0.5px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.hero-metrics-title .counter-highlight {\r\n  color: #fbbf24;\r\n  font-weight: 900;\r\n}\r\n\r\n.hero-eta-sub {\r\n  font-size: 18px;\r\n  font-weight: normal;\r\n  color: #94a3b8;\r\n  margin-left: 8px;\r\n}\r\n\r\n.hero-eta-sub strong {\r\n  color: #f1f5f9;\r\n}\r\n\r\n.hero-desc-p {\r\n  margin: 0;\r\n  font-size: 13.5px;\r\n  color: #cbd5e1;\r\n  line-height: 1.5;\r\n}\r\n\r\n.hero-right-actions {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 250px;\r\n}\r\n\r\n.simulate-reroute-btn {\r\n  padding: 14px 22px;\r\n  border-radius: 16px;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n  cursor: pointer;\r\n  border: none;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.simulate-reroute-btn.default {\r\n  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);\r\n  color: #0f172a;\r\n  box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);\r\n}\r\n\r\n.simulate-reroute-btn.default:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 12px 24px rgba(245, 158, 11, 0.4);\r\n}\r\n\r\n.simulate-reroute-btn.surge-active {\r\n  background: rgba(16, 185, 129, 0.2);\r\n  color: #6ee7b7;\r\n  border: 1.5px solid rgba(16, 185, 129, 0.5);\r\n  cursor: default;\r\n}\r\n\r\n.simulate-subtext {\r\n  font-size: 11px;\r\n  text-align: center;\r\n  color: #94a3b8;\r\n}\r\n\r\n/* 4. KPI Cards Grid */\r\n.hotel-kpi-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\r\n  gap: 14px;\r\n}\r\n\r\n.hotel-kpi-item {\r\n  background: rgba(30, 41, 59, 0.7);\r\n  border: 1px solid rgba(51, 65, 85, 0.8);\r\n  border-radius: 18px;\r\n  padding: 16px;\r\n  backdrop-filter: blur(8px);\r\n  transition: all 0.2s;\r\n}\r\n\r\n.hotel-kpi-item:hover {\r\n  border-color: #64748b;\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.kpi-title-row {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: #94a3b8;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n.kpi-main-metric {\r\n  font-size: 22px;\r\n  font-weight: 800;\r\n  color: #ffffff;\r\n  margin-top: 8px;\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 4px;\r\n}\r\n\r\n.metric-accent {\r\n  color: #fbbf24;\r\n}\r\n\r\n.metric-denom {\r\n  font-size: 13px;\r\n  color: #64748b;\r\n  font-weight: 500;\r\n}\r\n\r\n.kpi-progress-bar {\r\n  width: 100%;\r\n  height: 6px;\r\n  background: #090d16;\r\n  border-radius: 999px;\r\n  margin-top: 8px;\r\n  overflow: hidden;\r\n}\r\n\r\n.kpi-progress-fill {\r\n  height: 100%;\r\n  background: #f59e0b;\r\n  border-radius: 999px;\r\n  transition: width 0.4s ease;\r\n}\r\n\r\n.kpi-footer-sub {\r\n  font-size: 11px;\r\n  color: #64748b;\r\n  margin-top: 6px;\r\n}\r\n\r\n/* 5. Rule-Based Surge Pricing Bar */\r\n.pricing-control-strip {\r\n  background: rgba(30, 41, 59, 0.5);\r\n  border: 1px solid rgba(51, 65, 85, 0.8);\r\n  border-radius: 18px;\r\n  padding: 16px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.pricing-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n\r\n.pricing-icon {\r\n  font-size: 26px;\r\n}\r\n\r\n.pricing-heading-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  color: #cbd5e1;\r\n}\r\n\r\n.sih-layer-tag {\r\n  font-size: 10px;\r\n  font-family: monospace;\r\n  background: #334155;\r\n  color: #cbd5e1;\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n  border: 1px solid #475569;\r\n}\r\n\r\n.pricing-detail-row {\r\n  font-size: 13px;\r\n  color: #94a3b8;\r\n  mar