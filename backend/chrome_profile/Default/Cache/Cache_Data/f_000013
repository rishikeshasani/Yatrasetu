rimary);\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.site-card-location {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.site-card-footer {\r\n  margin-top: 14px;\r\n  padding-top: 10px;\r\n  border-top: 1px solid #f1f5f9;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 11px;\r\n}\r\n\r\n.capacity-stat {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.view-details-arrow {\r\n  color: var(--saffron-600);\r\n  font-weight: 700;\r\n}\r\n\r\n/* ==========================================================================\r\n   3.1 ACTIVE SHRINE HUB & COMPACT STRIP (COLLAPSIBLE DRAWER)\r\n   ========================================================================== */\r\n.selector-compact-strip {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.active-shrine-meta-wrap {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  flex: 1 1 360px;\r\n}\r\n\r\n.active-shrine-icon-box {\r\n  position: relative;\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: var(--radius-lg);\r\n  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);\r\n  border: 1.5px solid #fed7aa;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 22px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.live-radar-dot {\r\n  position: absolute;\r\n  top: -2px;\r\n  right: -2px;\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n  background: #10b981;\r\n  border: 2px solid #ffffff;\r\n  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);\r\n  animation: radar-pulse 2s infinite;\r\n}\r\n\r\n@keyframes radar-pulse {\r\n  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }\r\n  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }\r\n  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }\r\n}\r\n\r\n.active-shrine-text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n}\r\n\r\n.active-label-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.active-monitoring-tag {\r\n  font-size: 10px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.05em;\r\n  color: #c2410c;\r\n  background: #fff7ed;\r\n  padding: 2px 7px;\r\n  border-radius: var(--radius-full);\r\n  border: 1px solid #fed7aa;\r\n}\r\n\r\n.active-occupancy-pill {\r\n  background: #f1f5f9;\r\n  padding: 2px 8px;\r\n  border-radius: var(--radius-full);\r\n}\r\n\r\n.active-capacity-pill {\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.active-title-row {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.active-shrine-heading {\r\n  font-size: 18px;\r\n  font-weight: 800;\r\n  color: var(--text-primary);\r\n  margin: 0;\r\n  line-height: 1.25;\r\n}\r\n\r\n.active-shrine-loc {\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n/* Compact Search & Toggle Controls */\r\n.selector-compact-controls {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.compact-search-box {\r\n  min-width: 220px;\r\n}\r\n\r\n.browse-shrines-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 9px 18px;\r\n  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);\r\n  color: #ffffff;\r\n  border: none;\r\n  border-radius: var(--radius-full);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n  box-shadow: 0 2px 8px rgba(234, 88, 12, 0.25);\r\n  white-space: nowrap;\r\n}\r\n\r\n.browse-shrines-btn:hover {\r\n  background: linear-gradient(135deg, #fb923c 0%, #f97316 100%);\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 4px 12px rgba(234, 88, 12, 0.35);\r\n}\r\n\r\n.browse-sh