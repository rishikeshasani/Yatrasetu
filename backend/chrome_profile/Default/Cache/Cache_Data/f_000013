0;\r\n  color: #059669;\r\n}\r\n\r\n/* Parking & Amenities Grid */\r\n.amenities-summary-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n.amenity-info-card {\r\n  background: #ffffff;\r\n  border: 1.5px solid var(--border-color);\r\n  border-radius: var(--radius-lg);\r\n  padding: 18px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.amenity-card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.amenity-icon {\r\n  font-size: 26px;\r\n}\r\n\r\n.amenity-title {\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n  color: var(--text-primary);\r\n}\r\n\r\n.amenity-subtitle {\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.parking-telemetry-box {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  background: #f8fafc;\r\n  padding: 10px;\r\n  border-radius: var(--radius-md);\r\n}\r\n\r\n.parking-stat-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 12px;\r\n}\r\n\r\n.parking-bar {\r\n  height: 8px;\r\n  background: #e2e8f0;\r\n  border-radius: var(--radius-full);\r\n  overflow: hidden;\r\n}\r\n\r\n.parking-bar-fill {\r\n  height: 100%;\r\n  background: #10b981;\r\n  border-radius: var(--radius-full);\r\n}\r\n\r\n.available-slots {\r\n  color: #059669;\r\n}\r\n\r\n.amenity-desc {\r\n  font-size: 12px;\r\n  color: #334155;\r\n  line-height: 1.4;\r\n}\r\n\r\n.amenity-footer-status {\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  color: #0f766e;\r\n  background: #f0fdfa;\r\n  padding: 5px 8px;\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.no-items-msg {\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n  padding: 20px;\r\n}\r\n\r\n\r\n/* ==========================================================================\r\n   5C. CREATE TEAM & LIVE PILGRIM GEOTRACKER\r\n   ==================================================================