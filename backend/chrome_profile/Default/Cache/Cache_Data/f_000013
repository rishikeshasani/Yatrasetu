=============================================================== */\r\n.reroute-guide-panel {\r\n  margin-top: 26px;\r\n  background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);\r\n  border: 2px solid #99f6e4;\r\n  border-radius: var(--radius-xl);\r\n  padding: 24px;\r\n  box-shadow: 0 10px 25px -5px rgba(13, 148, 136, 0.12);\r\n  animation: slide-up 0.3s ease-out;\r\n}\r\n\r\n.guide-header-bar {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  flex-wrap: wrap;\r\n  gap: 14px;\r\n  padding-bottom: 18px;\r\n  border-bottom: 1px solid #ccfbf1;\r\n}\r\n\r\n.guide-tagline {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 10px;\r\n  font-weight: 800;\r\n  color: #0f766e;\r\n  background: #ccfbf1;\r\n  padding: 3px 10px;\r\n  border-radius: var(--radius-full);\r\n  letter-spacing: 0.6px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.live-pulse-dot {\r\n  width: 6px;\r\n  height: 6px;\r\n  background: #0d9488;\r\n  border-radius: 50%;\r\n  animation: pulse-animation 1.5s infinite;\r\n}\r\n\r\n.guide-main-heading {\r\n  font-size: 20px;\r\n  font-weight: 800;\r\n  color: var(--text-primary);\r\n  letter-spacing: -0.3px;\r\n}\r\n\r\n.guide-sub-heading {\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n  margin-top: 2px;\r\n}\r\n\r\n.guide-header-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.guide-overall-crowd-chip {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 12px;\r\n  background: #ecfdf5;\r\n  color: #065f46;\r\n  border: 1px solid #a7f3d0;\r\n  padding: 6px 12px;\r\n  border-radius: var(--radius-full);\r\n}\r\n\r\n.chip-bullet {\r\n  width: 7px;\r\n  height: 7px;\r\n  background: #10b981;\r\n  border-radius: 50%;\r\n}\r\n\r\n.guide-close-btn {\r\n  padding: 6px 12px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: #475569;\r\n  background: #e2e8f0;\r\n  border-radius: var(--radius-full);\r\n  transition: all 0.