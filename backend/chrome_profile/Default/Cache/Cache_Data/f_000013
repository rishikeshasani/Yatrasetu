t-hazard { background: #ef4444; }\r\n\r\n/* Radar Screen Container */\r\n.radar-screen {\r\n  position: relative;\r\n  width: 100%;\r\n  aspect-ratio: 1 / 1;\r\n  max-height: 420px;\r\n  margin: 0 auto;\r\n  background: radial-gradient(circle, #1e293b 0%, #090d16 100%);\r\n  border: 2px solid #334155;\r\n  border-radius: 50%;\r\n  overflow: hidden;\r\n  box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.8);\r\n}\r\n\r\n/* Concentric Rings */\r\n.radar-ring {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  border-radius: 50%;\r\n  pointer-events: none;\r\n}\r\n\r\n.ring-outer {\r\n  width: 92%;\r\n  height: 92%;\r\n  border: 1px dashed rgba(148, 163, 184, 0.25);\r\n}\r\n\r\n.ring-safe-boundary {\r\n  width: 66%;\r\n  height: 66%;\r\n  border: 2px dashed rgba(239, 68, 68, 0.6);\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: center;\r\n}\r\n\r\n.boundary-label {\r\n  font-size: 8px;\r\n  font-weight: 800;\r\n  color: rgba(239, 68, 68, 0.85);\r\n  letter-spacing: 0.8px;\r\n  background: #090d16;\r\n  padding: 1px 4px;\r\n  border-radius: 2px;\r\n  margin-top: -6px;\r\n}\r\n\r\n.ring-mid {\r\n  width: 42%;\r\n  height: 42%;\r\n  border: 1px solid rgba(13, 148, 136, 0.35);\r\n}\r\n\r\n.ring-inner {\r\n  width: 22%;\r\n  height: 22%;\r\n  border: 1px solid rgba(13, 148, 136, 0.45);\r\n}\r\n\r\n/* Crosshairs */\r\n.radar-crosshair {\r\n  position: absolute;\r\n  background: rgba(148, 163, 184, 0.18);\r\n  pointer-events: none;\r\n}\r\n.crosshair-v { width: 1px; height: 100%; left: 50%; top: 0; }\r\n.crosshair-h { width: 100%; height: 1px; top: 50%; left: 0; }\r\n\r\n/* Radar Sweep Beam */\r\n.radar-sweep-beam {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 50%;\r\n  height: 50%;\r\n  transform-origin: 0% 0%;\r\n  background: linear-gradient(45deg, rgba(13, 148, 136, 0.45) 0%, transparent 60%);\r\n  border-radius: 0 100% 0 0;\r\n  animation: radar-sweep 4s linear infinite;\r\n  pointer-events: none;\r\n}\r\n\r\n@keyframes radar-sweep {\r\n  from { transform: rotate(0deg); }\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n/* Central Shrine */\r\n.radar-shrine-marker {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  z-index: 10;\r\n  pointer-events: none;\r\n}\r\n\r\n.shrine-pin {\r\n  font-size: 20px;\r\n}\r\n\r\n.shrine-label {\r\n  font-size: 9px;\r\n  font-weight: 700;\r\n  color: #fde68a;\r\n  text-shadow: 0 1px 3px black;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Member Blips */\r\n.radar-blip {\r\n  position: absolute;\r\n  transform: translate(-50%, -50%);\r\n  z-index: 20;\r\n  cursor: pointer;\r\n}\r\n\r\n.blip-core {\r\n  width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  box-shadow: 0 0 8px rgba(0, 0, 0, 0.8);\r\n}\r\n\r\n.blip-leader .blip-core {\r\n  background: #f59e0b;\r\n  color: #78350f;\r\n  border: 1.5px solid #fde68a;\r\n}\r\n\r\n.blip-safe .blip-core {\r\n  background: #10b981;\r\n  color: white;\r\n  border: 1.5px solid #a7f3d0;\r\n}\r\n\r\n.blip-danger .blip-core {\r\n  background: #ef4444;\r\n  color: white;\r\n  border: 1.5px solid #fecaca;\r\n  animation: pulse-critical 1.2s infinite;\r\n}\r\n\r\n.blip-pulse-ring {\r\n  position: absolute;\r\n  inset: -4px;\r\n  border-radius: 50%;\r\n  border: 1.5px solid #10b981;\r\n  animation: pulse-animation 2s infinite;\r\n  pointer-events: none;\r\n}\r\n\r\n.blip-danger .blip-pulse-ring {\r\n  border-color: #ef4444;\r\n  animation: pulse-critical 1.2s infinite;\r\n}\r\n\r\n.blip-tooltip {\r\n  position: absolute;\r\n  bottom: 24px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  background: rgba(15, 23, 42, 0.95);\r\n  border: 1px solid #334155;\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n  display: flex;\r\n  g