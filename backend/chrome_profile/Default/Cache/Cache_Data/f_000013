shadow: var(--shadow-sm);\r\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.site-selector-card.is-expanded {\r\n  padding: 20px;\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n.search-box {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  min-width: 280px;\r\n}\r\n\r\n.search-icon {\r\n  position: absolute;\r\n  left: 12px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.search-input {\r\n  width: 100%;\r\n  padding: 9px 36px 9px 36px;\r\n  border-radius: var(--radius-full);\r\n  border: 1px solid var(--border-color);\r\n  font-size: 13px;\r\n  background: #f8fafc;\r\n  outline: none;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.search-input:focus {\r\n  background: #ffffff;\r\n  border-color: var(--saffron-500);\r\n  box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);\r\n}\r\n\r\n.clear-search-btn {\r\n  position: absolute;\r\n  right: 12px;\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.filter-chips-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-top: 14px;\r\n  margin-bottom: 18px;\r\n  overflow-x: auto;\r\n  padding-bottom: 4px;\r\n}\r\n\r\n.filter-chip {\r\n  padding: 6px 14px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  border-radius: var(--radius-full);\r\n  background: var(--bg-card-subtle);\r\n  color: var(--text-secondary);\r\n  border: 1px solid var(--border-color);\r\n  white-space: nowrap;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.filter-chip:hover {\r\n  background: #e2e8f0;\r\n}\r\n\r\n.filter-chip.active {\r\n  background: var(--saffron-500);\r\n  color: white;\r\n  border-color: var(--saffron-600);\r\n  box-shadow: 0 2px 6px rgba(249, 115, 22, 0.25);\r\n}\r\n\r\n.sites-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));\r\n  gap: 14px;\r\n}\r\n\r\n.site-card-item {\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  padding: 16px;\r\n  border-radius: var(--radius-lg);\r\n  border: 1.5px solid var(--b